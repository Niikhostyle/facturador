# === Facturador GDT DevSur — conexión SII ===
# Copia este archivo a .env.local y completa lo que se pide.

# certificacion = maullin.sii.cl | produccion = palena.sii.cl
SII_AMBIENTE=certificacion

# RUT emisor (empresa) con guión, ej: 12345678-5
SII_RUT_EMPRESA=

# RUT del titular del certificado digital (persona natural o empresa)
SII_RUT_CERTIFICADO=

# Certificado tributario .p12 / .pfx (ruta absoluta o relativa al proyecto)
SII_CERT_PATH=./data/certs/empresa.p12
SII_CERT_PASSWORD=

# Resolución SII del emisor (en certificación suele ser 0 / fecha de postulación)
# Certificación: NroResol=0 y FchResol = fecha de autorización en maullín (no inventar)
SII_NRO_RESOLUCION=0
SII_FECHA_RESOLUCION=2026-11-13

# Opcional: carpeta con CAF XML descargados del SII
SII_CAF_DIR=./data/caf

# true = envía a maullin/palena (obligatorio en operación real)
SII_ENABLED=true

# === Base de datos (MariaDB/MySQL) — esquema en db/schema.sql ===
# Usa DB_SOCKET (socket local) o DB_HOST/DB_PORT
DB_SOCKET=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Firma de sesiones y cifrado de claves de certificado (mínimo 32 caracteres).
# Cambiarlo invalida las sesiones y obliga a volver a subir los certificados.
AUTH_SECRET=
