# === Facturador GDT DevSur — conexión SII ===
# Copia este archivo a .env.local y completa lo que se pide.

# certificacion = maullin.sii.cl | produccion = palena.sii.cl
SII_AMBIENTE=certificacion

# RUT emisor (empresa) con guión, ej: 78533567-8
SII_RUT_EMPRESA=78533567-8

# RUT del titular del certificado digital (persona natural o empresa)
SII_RUT_CERTIFICADO=

# Certificado tributario .p12 / .pfx (ruta absoluta o relativa al proyecto)
SII_CERT_PATH=./data/certs/empresa.p12
SII_CERT_PASSWORD=

# Resolución SII del emisor (en certificación suele ser 0 / fecha de postulación)
SII_NRO_RESOLUCION=0
SII_FECHA_RESOLUCION=2026-01-01

# Opcional: carpeta con CAF XML descargados del SII
SII_CAF_DIR=./data/caf

# true = intenta llamar maullin/palena; false = solo simulación local
SII_ENABLED=false
